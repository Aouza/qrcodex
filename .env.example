# Copy to .env.local and replace these examples with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# No server-only key is required by the current clients. Both use the
# publishable key so database access remains subject to RLS.
# Never add a Supabase secret or service-role key with a NEXT_PUBLIC_ prefix.

# Optional experimental YouTube Music POC configuration.
# For the POC only, YOUTUBE_REFRESH_TOKEN may live in .env.local.
# Do not commit real Google OAuth values.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PLAYLIST_ID=

# THIS IS POC-ONLY DEVICE/PLAYER AUTHORIZATION. Use a random key >= 32 characters.
# Enter it only in the TV setup form; never in URLs or NEXT_PUBLIC_ variables.
YOUTUBE_POC_PLAYER_KEY=
# Server-only database credential for restricted playback RPCs. Never sent to TV.
SUPABASE_SERVICE_ROLE_KEY=
