# Copy to .env.local and replace these examples with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# No server-only key is required by baseline clients. Both use the
# publishable key for baseline public/admin data; Music alone uses narrow server RPCs.
# Never add a Supabase secret or service-role key with a NEXT_PUBLIC_ prefix.

# Optional experimental YouTube Music POC configuration.
# For the POC only, YOUTUBE_REFRESH_TOKEN may live in .env.local.
# Do not commit real Google OAuth values.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PLAYLIST_ID=

# THIS IS POC-ONLY DEVICE/PLAYER AUTHORIZATION. Use a random key >= 32 characters.
# Enter it only in the TV setup form; never in URLs or NEXT_PUBLIC_ variables.
YOUTUBE_POC_PLAYER_KEY=
# Server-only database credential for restricted Music RPCs (POC and production). Never sent to TV.
SUPABASE_SERVICE_ROLE_KEY=

# TASK-055 production application (local implementation; enable only with approved migrations).
# Keep false until production migrations, quota budgets and release gates are ready.
MUSIC_PRODUCTION_ENABLED=false
# Independent random signing/HMAC key >=32 characters; server-only. Never commit values.
MUSIC_SESSION_SECRET=
# Exact browser-facing origin (HTTPS in hosted production), without a path.
# Preview may omit this and use the trusted server VERCEL_URL environment value.
MUSIC_APP_ORIGIN=
# Explicit fixed identity for trusted local development only, not a proxy/IP header.
MUSIC_LOCAL_NETWORK_ID=
# Read-only public-video YouTube Data API key; independent of POC OAuth/playlist credentials.
YOUTUBE_MUSIC_API_KEY=
# Reserve actual costs against separate DB search/video budgets (both default zero).
YOUTUBE_MUSIC_SEARCH_COST=1
YOUTUBE_MUSIC_VIDEO_COST=1
# Optional random >=32 characters, server-only, for manual cleanup authorization.
# Optional manual HTTP cleanup; Supabase Cron uses no HTTP secret.
CRON_SECRET=
